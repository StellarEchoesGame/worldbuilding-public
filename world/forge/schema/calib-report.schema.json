{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calib-report.schema.json",
  "title": "WB-F1 calibration report",
  "description": "calibration/round0.json (C00), requal-<Qnn>.json and gate-<Gnn>.json: one per set, written once by engine/calib-score.ts (c5-score) and reused on rerun. valid false (root benchmark version logged no earlier than the first C00 answer, or an owner answer failing the owner-log checks) qualifies nobody. families and gate_dryrun are keyed by family; the per-family schemas are repeated for every family of engine/config.ts FAMILIES (no $ref in the schema subset; calib-score.test.ts keeps the copies identical). parseCalibReport also checks what the subset cannot express: agree <= m, correct <= k, consistent <= n, caught <= of, qualified lists exactly the qualified families of a valid report.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "set",
    "kind",
    "family",
    "reason",
    "valid",
    "invalid_reason",
    "pin_sha256",
    "after_round",
    "families",
    "qualified",
    "canon_rounds_may_start",
    "owner",
    "writer_models",
    "writer_recommendation",
    "gate_dryrun"
  ],
  "properties": {
    "set": { "type": "string", "pattern": "^[CQG]\\d{2}$" },
    "kind": { "enum": ["round0", "requal", "gate"] },
    "family": { "enum": ["DeepSeek", "Anthropic", "OpenAI", "Moonshot", "xAI", "Alibaba", "Zhipu", "MiniMax", null] },
    "reason": { "enum": ["calibration_fail", "suspension", null] },
    "valid": { "type": "boolean" },
    "invalid_reason": { "type": ["string", "null"] },
    "pin_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "after_round": { "type": ["string", "null"], "pattern": "^R\\d{2}$" },

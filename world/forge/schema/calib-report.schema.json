            "nonknown": {
              "type": "object",
              "additionalProperties": false,
              "required": ["m", "agree", "need", "wilson90"],
              "properties": {
                "m": { "type": "integer", "minimum": 0 },
                "agree": { "type": "integer", "minimum": 0 },
                "need": { "type": "integer", "minimum": 0 },
                "wilson90": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            },
            "known": {
              "type": "object",
              "additionalProperties": false,
              "required": ["k", "correct", "need"],
              "properties": {
                "k": { "type": "integer", "minimum": 0 },
                "correct": { "type": "integer", "minimum": 0 },
                "need": { "type": "integer", "minimum": 0 }
              }
            },
            "by_category": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "canon_vs_rewrite": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["m", "agree"],
                  "properties": { "m": { "type": "integer", "minimum": 0 }, "agree": { "type": "integer", "minimum": 0 } }
                },
                "cross_model": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["m", "agree"],
                  "properties": { "m": { "type": "integer", "minimum": 0 }, "agree": { "type": "integer", "minimum": 0 } }
                },
                "stance": {

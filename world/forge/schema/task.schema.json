{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task.schema.json",
  "title": "WB-F1 task record",
  "description": "tasks/<id>.json (sealed tasks: .sealed/<RNN>/tasks/<id>.json), written by engine/task.ts runTask after the last call of a task. text is the accepted raw output ('' when void); on resume the task's parser rebuilds its value from text. prompt_sha256 is the hash of the first prompt only; a retry prompt's hash is in its call record. calls lists the counted call labels <id>-a1 / <id>-a2 (quota tries <id>-a<k>-q<n> are never listed). error is redacted ASCII.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "backend", "family", "model", "role_sha256", "prompt_sha256", "status", "attempts", "error", "text", "text_sha256", "served_model", "version", "calls", "finished_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,150}$"},
    "backend": {"type": "string", "minLength": 1},
    "family": {
      "type": "string",
      "enum": ["DeepSeek", "Anthropic", "OpenAI", "Moonshot", "xAI", "Alibaba", "Zhipu", "MiniMax"]
    },
    "model": {"type": "string", "minLength": 1},
    "role_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"type": "string", "enum": ["ok", "void"]},
    "attempts": {"type": "integer", "minimum": 1, "maximum": 2},
    "error": {"type": ["string", "null"]},
    "text": {"type": "string"},
    "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "served_model": {"type": ["string", "null"]},
    "version": {"type": ["string", "null"]},
    "calls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,150}-a[12]$"}
    },
    "finished_at": {"type": "string", "minLength": 1}
  }
}
